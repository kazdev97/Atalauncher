{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atalauncher",
  "version": "0.1.3",
  "identifier": "com.kaz.atalauncher",
  "build": {
    "beforeBuildCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "Atalauncher",
        "width": 1180,
        "height": 760,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "Atalauncher - launcher de Minecraft",
    "longDescription": "Launcher de Minecraft con control local de instancias, mods, configs y Java Adoptium por versión."
  }
}